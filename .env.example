# Copy to .env and fill in. Never commit .env.

# Claude API (the payments agent)
ANTHROPIC_API_KEY=
# Optional: model and effort for the agent
# TRANCHE_MODEL=claude-opus-5-5
# TRANCHE_EFFORT=low

# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox test accounts (developer.paypal.com -> Sandbox -> Accounts)
# The business account the REST app belongs to (it sends the invoices and the payouts)
PAYPAL_BUSINESS_EMAIL=
# The personal account that plays the client, pays invoices and approves the deposit hold
TRANCHE_CLIENT_EMAIL=
TRANCHE_CLIENT_PASSWORD=
# Three personal accounts that play the crew, comma separated (they receive payouts)
TRANCHE_CREW_EMAILS=

# Any long random string. Signs the workspace the browser carries.
TRANCHE_STATE_SECRET=

# Optional: when set, the agent and every PayPal write need this code (x-tranche-code header)
# TRANCHE_ACCESS_CODE=
# Optional: public address of the app, used for the PayPal return link
# APP_URL=https://your-app.example.com
